# Dev local Mandala — copier vers .env ou sync-config.env
# Dev VPS (recommandé) : npm run dev.vps — voir sync-config.env.example

MARIADB_HOST=127.0.0.1
MARIADB_PORT=3308
MARIADB_DATABASE=default
MARIADB_USER=mariadb
MARIADB_PASSWORD=

DB_PREFIX=mdl_
JWT_SECRET=change_me_dev_only
JWT_EXPIRE_HOURS=720

NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BASE_PATH=

# E-mails (mot de passe oublié, invitations) — même SMTP Hostinger que Fleur d'Amour
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Mandala <contact@eludein.art>"
# SMTP_REPLY_TO=
# Secours optionnel si SMTP n'est pas renseigné :
# RESEND_API_KEY=
# MANDALA_MAIL_FROM=Mandala <noreply@example.com>
# Copie e-mail des questions et bugs (bouton ?). Sans cette variable, ils restent dans Administration → Retours.
# SUPPORT_EMAIL=

# Web Push (VAPID) — générer avec : npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY doit être exposé au client (subscribe)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

MARIADB_POOL_LIMIT=2
