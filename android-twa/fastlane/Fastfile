# frozen_string_literal: true

# Mandala — lanes Play (Ruby/fastlane optionnel).
# Sur Windows sans Ruby : utiliser scripts/play-store (Node + Play API).
# Doc : docs/PLAY-STORE-API.md

default_platform(:android)

platform :android do
  desc "Push fiche store FR (textes + images) depuis fastlane/metadata"
  lane :store_listing do
    supply(
      track: "internal",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      sync_image_upload: true,
      metadata_path: "fastlane/metadata/android"
    )
  end

  desc "Upload AAB vers piste interne (sans toucher la fiche)"
  lane :internal_aab do |options|
    aab = options[:aab] || "../app-release-bundle.aab"
    supply(
      track: "internal",
      aab: aab,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false
    )
  end
end
